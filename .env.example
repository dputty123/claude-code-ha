# Home Assistant API Configuration
# Copy this file to .env and fill in your values

# Internal URL for HA OS (default) — host gateway as seen from the SSH add-on.
# HA core serves plain http on 8123 unless you've configured SSL in HA itself;
# if you have, change this to https://
HA_URL=http://172.30.32.1:8123

# Or use your external URL if accessing from outside
# HA_URL=https://your-ha-instance.com:8123

# Long-lived access token
# Get one from: Profile -> Long-Lived Access Tokens -> Create Token
HA_TOKEN=your_long_lived_access_token_here
